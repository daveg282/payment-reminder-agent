DATABASE_URL=
TEST_DATABASE_URL=       # separate database for `npm test` (its tables get truncated)
APP_PASSWORD=            # single-user login
SESSION_SECRET=
JOB_SECRET=              # header X-Job-Secret for /jobs/run
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=     # e.g. http://localhost:4000/auth/google/callback
SHEET_ID=                # reserved for an optional Google Sheet source (not used yet)
CLIENT_ORIGIN=           # e.g. http://localhost:5173
SENDER_NAME=
PORT=                    # defaults to 4000
DEMO_LIVE_EMAIL=         # demo seed only: the inbox you reply from on camera
